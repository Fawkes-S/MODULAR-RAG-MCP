# Copy this file to `.env` and fill your real values.
# Do NOT commit `.env`.
#
# Usage:
# - Switch text LLM by editing `llm.profile` in `config/settings.yaml`
# - Switch vision LLM by editing `vision_llm.profile` in `config/settings.yaml`
# - Keep all provider-specific keys here; you usually do not need to rename vars later

# ============================================================================
# Text LLM profiles
# ============================================================================

# minimax profile
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_API_KEY=

# qwen profile
QWEN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_LLM_API_KEY=

# deepseek profile
DEEPSEEK_LLM_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_LLM_API_KEY=
DEEPSEEK_LLM_PROXY=

# openai profile
OPENAI_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_API_KEY=
OPENAI_LLM_PROXY=

# ============================================================================
# Vision LLM profiles
# ============================================================================

# qwen vision profile
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_API_KEY=

# gemini_flash vision profile (OpenAI-compatible Gemini endpoint)
GEMINI_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_VISION_API_KEY=
GEMINI_VISION_PROXY=
